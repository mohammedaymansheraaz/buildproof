# BuildProof environment template
# Leave all optional integration values empty to run the complete local demo.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
AUDIT_MODE=demo
CREDENTIAL_ENCRYPTION_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DATABASE_URL=
DIRECT_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Supabase Auth + PostgreSQL (required for the real multi-user product)
# Create your own Supabase project; never use a public/shared key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Temporary Clerk migration variables. Remove after Supabase Auth is live.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_AFTER_SIGN_OUT_URL=/

AUDIT_RUNNER_URL=
AUDIT_RUNNER_TOKEN=
