# BuildProof environment template
# Leave optional runner integrations empty; Supabase is required for real auth
# and persisted audit data.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
AUDIT_MODE=live
# Optional. If empty, BYOK keys can still be saved server-side in Supabase;
# add a value later to encrypt saved model keys at rest.
CREDENTIAL_ENCRYPTION_KEY=

# AI providers stay server-only. The submission path uses GPT-5.6 through OpenAI.
AI_PROVIDER=openai
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=BuildProof

# Optional OpenAI-compatible Nebius Token Factory fallback.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Temporary personal token for a founder-owned prototype only. Never expose it
# to the browser, Markdown, screenshots, or Git. Prefer a GitHub App later.
GITHUB_TOKEN=
# Deferred GitHub App integration.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DATABASE_URL=
DIRECT_URL=
MIGRATION_DATABASE_URL=
REDIS_URL=

S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Supabase Auth + PostgreSQL (required for the real multi-user product)
# Create your own Supabase project; never use a public/shared key. The
# NEXT_PUBLIC_* values are browser-safe publishable values, not service keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional aliases supported by the server if you prefer these names locally.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only admin key for writing findings, evidence, events, and reports.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Temporary Clerk migration variables. Remove after Supabase Auth is live.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
CLERK_AFTER_SIGN_OUT_URL=/

AUDIT_RUNNER_URL=
AUDIT_RUNNER_TOKEN=
